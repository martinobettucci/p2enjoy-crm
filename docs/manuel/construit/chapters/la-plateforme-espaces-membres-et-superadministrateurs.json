								"type": "text",
								"text": " montre la forme qu'aura une adresse."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Changer le préfixe ne vaut que pour les affaires créées ensuite."
