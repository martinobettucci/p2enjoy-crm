			"height": 80
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "La fiche d'un espace liste ses "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Tracks »"
						}
					]
				},
				{
					"type": "text",
					"text": ", avec le nombre de leurs channels et de leurs affaires. "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Déplacer vers un\nautre espace »"
						}
					]
				},
				{
					"type": "text",
					"text": " emporte un track "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "entier"
						}
					]
				},
				{
					"type": "text",
					"text": " dans un autre espace : ses channels, ses affaires, et tout ce qui leur est\nrattaché — commentaires, pièces jointes, historique, mails, budgets, coûts, recettes et temps saisis."
				}
			]
		},
		{
			"type": "list",
			"ordered": true,
			"start": 1,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Choisissez l'« Espace d’arrivée »."
									}
								]
							},
							{
								"type": "text",
								"text": " L'aperçu se calcule aussitôt. Rien n'est encore écrit."
