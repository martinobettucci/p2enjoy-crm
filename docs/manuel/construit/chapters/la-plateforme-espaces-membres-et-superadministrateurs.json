		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Les adresses des affaires."
						}
					]
				},
				{
					"type": "text",
					"text": " Une affaire reçoit une adresse faite du préfixe de son espace, de huit caractères tirés\nau hasard, puis du domaine entrant : "
				},
				{
					"type": "code",
					"text": "app-3p55qdgw@votre-domaine.fr"
				},
				{
					"type": "text",
					"text": ". Le préfixe vaut "
				},
				{
					"type": "code",
					"text": "c-"
				},
				{
					"type": "text",
					"text": " par défaut. Réglez-le sur le\nmotif que votre serveur de messagerie remet au CRM — un alias "
				},
				{
					"type": "code",
					"text": "app-*"
				},
				{
					"type": "text",
					"text": " vers la boîte système, par exemple —, sans quoi\nles messages envoyés aux affaires n'arrivent nulle part."
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
