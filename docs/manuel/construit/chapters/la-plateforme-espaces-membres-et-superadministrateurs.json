				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Régénérer les adresses »"
									}
								]
							},
							{
								"type": "text",
								"text": " leur en donne une nouvelle, au préfixe courant — affaires en corbeille comprises. Une\nconfirmation dit ce que cela coûte : un message écrit à une "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "ancienne"
									}
								]
							},
							{
								"type": "text",
								"text": " adresse ne sera plus rangé dans l'affaire.\nLes réponses aux messages déjà rangés le seront encore, tant que votre serveur remet l'ancien motif au CRM : gardez\ndonc l'ancien alias le temps que les échanges en cours se terminent. Les messages déjà rangés ne changent pas\nd'affaire. Une affaire qui porte déjà le préfixe courant garde son adresse."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Dans l'ordre :"
									}
								]
							},
							{
								"type": "text",
								"text": " créez l'alias du nouveau préfixe sur votre serveur, réglez le préfixe, puis régénérez."
							}
						]
					}
				]
			]
		},
