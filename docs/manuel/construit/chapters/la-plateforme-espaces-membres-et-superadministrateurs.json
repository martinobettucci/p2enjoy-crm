				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Ce qu'elle demande :"
									}
								]
							},
							{
								"type": "text",
								"text": " de "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "saisir l'identifiant court"
									}
