						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Lisez l'aperçu."
									}
								]
							}
						]
					},
					{
						"type": "list",
						"ordered": false,
						"start": null,
						"items": [
							[
								{
									"type": "paragraph",
									"content": [
										{
											"type": "strong",
											"content": [
												{
													"type": "text",
													"text": "« Ce qui part »"
												}
											]
										},
										{
											"type": "text",
											"text": " : le nombre de channels, d'affaires, de mails, de pièces jointes, de commentaires, de temps saisis,\nde budgets, de coûts, de recettes et de webhooks."
										}
									]
								}
							],
							[
								{
									"type": "paragraph",
									"content": [
										{
											"type": "strong",
											"content": [
												{
													"type": "text",
													"text": "« Référentiels »"
												}
											]
										},
										{
											"type": "text",
											"text": " : ce que le track emploie — workflows, étapes, champs communs, étiquettes, contacts,\norganisations, pastilles des mails, séquences de relance, modèles de mail. Chacun est "
										},
										{
											"type": "strong",
											"content": [
												{
													"type": "text",
													"text": "réutilisé"
												}
											]
										},
										{
											"type": "text",
											"text": " si l'espace\nd'arrivée en a un du même nom (un contact du même e-mail, une organisation du même domaine), et "
										},
										{
											"type": "strong",
											"content": [
												{
													"type": "text",
													"text": "créé"
												}
											]
										},
										{
											"type": "text",
											"text": " sinon.\nL'aperçu sépare « Réutilisés à l'arrivée » et « Créés à l'arrivée »."
										}
									]
								}
							],
							[
								{
									"type": "paragraph",
									"content": [
										{
											"type": "strong",
											"content": [
												{
													"type": "text",
													"text": "« Temps et coûts »"
												}
											]
										},
										{
											"type": "text",
											"text": " : les temps saisis sont valorisés au coût du personnel de l'espace d'arrivée. L'aperçu donne\nla valeur au départ, à l'arrivée, l'écart, et les personnes qui n'ont pas de coût à l'arrivée."
										}
									]
								}
							],
							[
								{
									"type": "paragraph",
									"content": [
										{
											"type": "strong",
											"content": [
												{
													"type": "text",
													"text": "Les mails déjà présents à l'arrivée"
												}
											]
										},
										{
											"type": "text",
											"text": ", s'il y en a — le même mail relevé par les deux espaces : l'exemplaire de\nl'arrivée est gardé, rangé dans l'affaire s'il ne l'était nulle part, et celui du départ est retiré."
										}
									]
								}
							],
							[
								{
									"type": "paragraph",
									"content": [
										{
											"type": "strong",
											"content": [
												{
													"type": "text",
													"text": "« Adresses des affaires »"
												}
											]
										},
										{
											"type": "text",
											"text": " : les nouvelles adresses prendront le domaine de l'espace d'arrivée. L'ancienne adresse\nd'une affaire continue d'aboutir à la même affaire."
										}
									]
								}
							]
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Saisissez le nom du track"
									}
								]
							},
							{
								"type": "text",
								"text": ", puis "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Déplacer le track »"
									}
								]
							},
							{
								"type": "text",
								"text": ". Le bouton reste inactif tant que la saisie diffère. Le\ndéplacement se fait d'un bloc : tout part, ou rien."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Le message dit où le track est parti, et "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Ouvrir la fiche de … »"
						}
					]
				},
				{
					"type": "text",
					"text": " mène à l'espace d'arrivée, qui le liste désormais.\n"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Annuler »"
						}
					]
				},
				{
					"type": "text",
					"text": ", ou la touche "
				},
				{
					"type": "code",
					"text": "Échap"
				},
				{
					"type": "text",
					"text": ", referme le bloc sans rien changer."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Quand le déplacement est refusé"
						}
					]
				},
				{
					"type": "text",
					"text": ", l'aperçu en liste les raisons, et n'offre aucune commande tant qu'il en reste une :"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "le track est déjà dans cet espace, ou il est à la corbeille ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "l'espace d'arrivée a un track du même nom ou de la même adresse ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "des affaires sont aussi rattachées à un autre track, qui reste au départ ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "des personnes que le track cite — ses membres, les responsables et les auteurs, les personnes mentionnées, celles qui ont\nsaisi du temps — ne sont pas membres de l'espace d'arrivée : ajoutez-les d'abord ("
							},
							{
								"type": "link",
								"target": {
									"chapter": "la-plateforme-espaces-membres-et-superadministrateurs",
									"anchor": "les-membres-d-un-espace"
								},
								"content": [
									{
										"type": "text",
										"text": "§32.4"
									}
								]
							},
							{
								"type": "text",
								"text": ") ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "des relances sont armées, des envois attendent en file, ou des mails préparés attendent leur relecture ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "un champ commun du même nom existe à l'arrivée, avec un autre type ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "des temps saisis feraient dépasser 7 heures par jour à une personne, dans l'espace d'arrivée."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Levez chaque raison, puis rouvrez le déplacement."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Ce qui reste au départ :"
						}
					]
				},
				{
					"type": "text",
					"text": " les boîtes mail et les adresses d'expédition, les tableaux d'objectifs, les coûts du personnel,\nles journaux. Un bloc d'objectifs qui cite un channel déplacé garde son lien, et nomme l'espace où vit désormais le channel."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Ce qui le dit :"
						}
					]
				},
				{
					"type": "text",
					"text": " le journal de la plateforme inscrit « Track déplacé », avec les deux espaces ("
				},
				{
					"type": "link",
					"target": {
						"chapter": "la-plateforme-espaces-membres-et-superadministrateurs",
						"anchor": "les-superadministrateurs-et-le-journal"
					},
					"content": [
						{
							"type": "text",
							"text": "§32.8"
						}
					]
				},
				{
					"type": "text",
					"text": "). L'historique de chaque\naffaire porte « Déplacée avec son track »."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Pour défaire un déplacement"
						}
					]
				},
				{
					"type": "text",
					"text": ", déplacez le track en sens inverse : chacun retrouve ses référentiels d'origine. Ceux qui ont\nété créés à l'arrivée y restent."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "les-utilisateurs",
			"content": [
				{
					"type": "text",
					"text": "32.7 Les utilisateurs"
				}
			]
		},
		{
			"type": "image",
			"src": "la-plateforme-espaces-membres-et-superadministrateurs/utilisateurs.jpg",
			"alt": "L'onglet « Utilisateurs » : « Rechercher un utilisateur », leurs espaces, la pilule « Superadministrateur », « Droits du connecteur »",
			"width": 1192,
			"height": 309
		},
		{
			"type": "image",
			"src": "la-plateforme-espaces-membres-et-superadministrateurs/aucun-espace.jpg",
			"alt": "Une personne sans espace : « Aucun espace »",
			"width": 1192,
			"height": 78
		},
		{
			"type": "image",
			"src": "la-plateforme-espaces-membres-et-superadministrateurs/rechercher.jpg",
			"alt": "Le champ « Rechercher un utilisateur »",
			"width": 444,
			"height": 97
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "L'onglet "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Utilisateurs »"
						}
					]
				},
				{
					"type": "text",
					"text": " liste toutes les personnes admises au moins une fois dans le CRM. Pour chacune, il\naffiche :"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "ses "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "espaces"
									}
								]
							},
							{
								"type": "text",
								"text": ", chacun suivi de son rôle ; un clic sur un espace ouvre sa fiche. « Aucun espace » dit qu'elle n'en a\nplus ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "la pilule "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Superadministrateur »"
									}
								]
							},
							{
								"type": "text",
								"text": ", si elle porte le drapeau ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "sa "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "dernière activité au connecteur MCP"
									}
								]
							},
							{
								"type": "text",
								"text": ", ou « Jamais connecté » ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "la date de sa première admission."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Rechercher un utilisateur »"
						}
					]
				},
				{
					"type": "text",
					"text": " filtre la liste par nom pendant que vous tapez, sans tenir compte des accents ni des\nmajuscules. La liste montre au plus 200 personnes ; au-delà, elle le dit, et la recherche affine."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "L'onglet ne modifie rien. Pour ajouter une personne à un espace, ouvrez la fiche de l'espace ("
				},
				{
					"type": "link",
					"target": {
						"chapter": "la-plateforme-espaces-membres-et-superadministrateurs",
						"anchor": "les-membres-d-un-espace"
					},
					"content": [
						{
							"type": "text",
							"text": "§32.4"
						}
					]
				},
				{
					"type": "text",
					"text": "). Pour lui donner\nle drapeau, passez par l'onglet « Superadministrateurs » ("
				},
				{
					"type": "link",
					"target": {
						"chapter": "la-plateforme-espaces-membres-et-superadministrateurs",
						"anchor": "les-superadministrateurs-et-le-journal"
					},
					"content": [
						{
							"type": "text",
							"text": "§32.8"
						}
					]
				},
				{
					"type": "text",
					"text": "). "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Droits du connecteur »"
						}
					]
				},
				{
					"type": "text",
					"text": ", sur chaque ligne, mène\nà ses droits du connecteur MCP ("
				},
				{
					"type": "link",
					"target": {
						"chapter": "le-connecteur-mcp-piloter-le-crm-depuis-votre-assistant"
					},
					"content": [
						{
							"type": "text",
							"text": "chapitre 33"
						}
					]
				},
				{
					"type": "text",
					"text": "). Le rôle "
				},
				{
					"type": "code",
					"text": "admin"
				},
				{
					"type": "text",
					"text": " LeLabs n'y est pas affiché : le CRM\nne le connaît que par la connexion."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "les-superadministrateurs-et-le-journal",
			"content": [
				{
					"type": "text",
					"text": "32.8 Les superadministrateurs et le journal"
				}
			]
		},
		{
			"type": "image",
			"src": "la-plateforme-espaces-membres-et-superadministrateurs/superadministrateurs.jpg",
			"alt": "L'onglet « Superadministrateurs » : le drapeau d'amorçage, « Retirer », « Accorder le drapeau »",
			"width": 1192,
			"height": 130
		},
		{
			"type": "image",
			"src": "la-plateforme-espaces-membres-et-superadministrateurs/journal.jpg",
			"alt": "Le journal de la plateforme : la date, l'acteur, le geste et son détail",
			"width": 1192,
			"height": 273
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "L'onglet "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Superadministrateurs »"
						}
					]
				},
				{
					"type": "text",
					"text": " liste les drapeaux posés dans le CRM."
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Amorçage »"
									}
								]
							},
							{
								"type": "text",
								"text": " désigne le premier drapeau, posé à l'installation."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Accorder le drapeau »"
									}
								]
							},
							{
								"type": "text",
								"text": " le donne à une personne déjà connectée ; "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Retirer »"
									}
								]
							},
							{
								"type": "text",
								"text": " le lui reprend, après\nconfirmation. Le dernier drapeau ne se retire pas : accordez-en un autre d'abord."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Les porteurs du rôle "
									},
									{
										"type": "code",
										"text": "admin"
									},
									{
										"type": "text",
										"text": " LeLabs"
									}
								]
							},
							{
								"type": "text",
								"text": " sont aussi superadministrateurs, mais n'y figurent pas."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "L'onglet "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Journal »"
						}
					]
				},
				{
					"type": "text",
					"text": " retrace chaque geste de la plateforme, du plus récent au plus ancien :"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "la date ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "qui a agi ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "le geste, en mots ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "son détail."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Entrées plus anciennes »"
						}
					]
				},
				{
					"type": "text",
					"text": " remonte le temps, une page après l'autre."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Le journal de la plateforme et celui des appels du connecteur sont "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "conservés un an"
						}
					]
				},
				{
					"type": "text",
					"text": ". Chaque nuit, le CRM efface les\nentrées plus anciennes, et inscrit le geste "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Journaux purgés »"
						}
					]
				},
				{
					"type": "text",
					"text": " avec le nombre d'entrées effacées de chacun. Personne\nne peut modifier ni supprimer une entrée de ces journaux ("
				},
				{
					"type": "link",
					"target": {
						"chapter": "le-journal-d-audit-ce-qui-s-est-fait-dans-votre-espace"
					},
					"content": [
						{
							"type": "text",
							"text": "chapitre 22"
						}
					]
				},
				{
					"type": "text",
					"text": ")."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "ce-que-la-plateforme-n-offre-pas",
			"content": [
				{
					"type": "text",
					"text": "32.9 Ce que la plateforme n'offre pas"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Gérer ses propres membres en tant qu'administrateur d'espace"
									}
								]
							},
							{
								"type": "text",
								"text": ", sans être superadministrateur : c'est l'écran\n« Réglages ▸ Membres » ("
							},
							{
								"type": "link",
								"target": {
									"chapter": "les-membres-de-votre-espace-qui-y-travaille-avec-quel-role"
								},
								"content": [
									{
										"type": "text",
										"text": "chapitre 21"
									}
								]
							},
							{
								"type": "text",
								"text": "), avec les attentes et les droits fins par track et par channel."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Changer l'identifiant court d'un espace."
									}
								]
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Choisir l'adresse d'une affaire en particulier"
									}
								]
							},
							{
								"type": "text",
								"text": " : elle est toujours tirée au hasard, après le préfixe."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Annuler une suppression."
									}
								]
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Déplacer une affaire ou un channel seul vers un autre espace"
									}
								]
							},
							{
								"type": "text",
								"text": " : le déplacement emporte toujours le track entier."
							}
						]
					}
				]
			]
		}
	]
}
