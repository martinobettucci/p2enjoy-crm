								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Adresses des affaires »"
									}
								]
							},
							{
								"type": "text",
								"text": " de la\nfiche dit combien d'affaires ont encore une adresse à l'ancien préfixe."
							}
