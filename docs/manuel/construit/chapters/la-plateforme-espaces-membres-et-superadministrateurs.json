			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Ce qu'elle dit :"
									}
								]
							},
							{
								"type": "text",
								"text": " ce que l'espace emporte avec lui — ses appartenances, ses attentes, et tout son contenu."
