							"text": " d'un même track ne portent pas le même nom ; un budget clôturé peut, lui, garder un nom qu'un nouveau budget reprend — « Salon 2025 » l'année suivante"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "Devise"
						}
					],
					[
						{
							"type": "text",
							"text": "trois lettres majuscules, "
						},
						{
							"type": "code",
							"text": "EUR"
						},
						{
							"type": "text",
							"text": " par défaut. Une autre écriture est signalée sur le champ, et « Créer » reste indisponible"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "Enveloppe (facultative)"
