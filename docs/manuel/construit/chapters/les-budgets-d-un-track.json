			"content": [
				{
					"type": "text",
					"text": "23.1 Les occurrences d'un budget récurrent"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Où."
