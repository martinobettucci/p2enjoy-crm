					],
					[
						{
							"type": "text",
							"text": "un nombre. "
						},
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "Laissez vide"
								}
							]
						},
						{
							"type": "text",
							"text": " si l'enveloppe n'est pas décidée ; un montant "
