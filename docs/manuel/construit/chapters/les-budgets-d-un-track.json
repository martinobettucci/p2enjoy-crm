					],
					[
						{
							"type": "text",
							"text": "Choisissez un autre nom, ou clôturez l'autre budget"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "« Ce budget porte des occurrences : supprimez-les avant de le rendre non récurrent. »"
						}
					],
					[
						{
							"type": "text",
							"text": "Retirez ses occurrences d'abord ("
						},
						{
							"type": "link",
							"target": {
