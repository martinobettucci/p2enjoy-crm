						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "négatif"
								}
							]
						},
						{
							"type": "text",
							"text": " est accepté — un avoir, un remboursement. Une saisie qui n'est pas un nombre est signalée sur le champ"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "Seuil d'ancienneté (facultatif)"
						}
					],
					[
						{
							"type": "text",
							"text": "un nombre de "
						},
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "jours entiers, à partir de 1"
								}
							]
						},
						{
							"type": "text",
							"text": ". Au delà, une dépense de ce budget qui attend son coût réel est signalée "
						},
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "en retard"
								}
							]
						},
						{
							"type": "text",
							"text": " dans l'onglet « À saisir » ("
						},
						{
							"type": "link",
