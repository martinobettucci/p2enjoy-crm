							"text": ")"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "« Cette valeur a été refusée : vérifiez le nom et la devise. »"
						}
					],
					[
						{
							"type": "text",
							"text": "Le serveur a refusé la forme d'une valeur"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "« Seul un administrateur de cet espace de travail peut gérer les budgets. »"
						}
					],
					[
						{
							"type": "text",
							"text": "Le geste demande un droit que votre compte n'a pas"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "« Rien n'a été modifié… »"
						}
					],
					[
						{
							"type": "text",
							"text": "Vos droits sur ce budget ont changé depuis l'ouverture de l'écran, ou il a disparu"
						}
					]
				]
			]
		},
