{
	"slug": "ecrire-des-modeles-d-emails-et-les-previsualiser",
	"title": "7. Écrire des modèles d'emails et les prévisualiser",
	"blocks": [
		{
			"type": "paragraph",
			"content": [
				{
					"type": "emphasis",
					"content": [
						{
							"type": "text",
							"text": "Livré par "
						},
						{
							"type": "code",
							"text": "CRM-063"
						},
						{
							"type": "text",
							"text": ", tranche 2. Les règles d'accès sont celles de la tranche 1 : cet écran n'en\ninvente aucune."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Où."
						}
					]
				},
				{
					"type": "text",
					"text": " Barre latérale ▸ "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Réglages"
						}
					]
				},
				{
					"type": "text",
					"text": " ▸ « Modèles d'emails »."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "À quoi cela sert."
						}
					]
				},
				{
					"type": "text",
					"text": " Un modèle est un texte que vous écrivez "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "une fois"
						}
					]
				},
				{
					"type": "text",
					"text": " et que tout l'espace de\ntravail réemploie : une relance sans réponse, une prise de contact. Il porte des "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "trous"
						}
					]
				},
				{
					"type": "text",
					"text": " —\n"
				},
				{
					"type": "code",
					"text": "{{card.title}}"
				},
				{
					"type": "text",
					"text": ", "
				},
				{
					"type": "code",
					"text": "{{contact.full_name}}"
				},
				{
					"type": "text",
					"text": " — que le produit remplace par les valeurs de l'affaire\nconcernée. Deux personnes qui écrivent au même prospect envoient ainsi le même texte."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Qui."
						}
					]
				},
				{
					"type": "text",
					"text": " Tout membre de l'espace de travail "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "lit"
						}
					]
				},
				{
					"type": "text",
					"text": " les modèles et peut les prévisualiser. Les\n"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "écrire"
						}
					]
				},
				{
					"type": "text",
					"text": " — créer, modifier, supprimer — est réservé aux rôles "
				},
				{
					"type": "emphasis",
					"content": [
						{
							"type": "text",
							"text": "administrateur"
						}
					]
				},
				{
					"type": "text",
					"text": " et "
				},
				{
					"type": "emphasis",
					"content": [
						{
							"type": "text",
							"text": "développement\ncommercial"
						}
					]
				},
				{
					"type": "text",
					"text": ". Aucun bouton n'est masqué selon votre rôle : si vous n'avez pas le droit d'écrire, le\nproduit vous le dit en toutes lettres au moment où vous enregistrez, plutôt que de vous laisser\ncroire que le geste n'existe pas."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "La liste."
						}
					]
				},
				{
					"type": "text",
					"text": " Une ligne par modèle : son "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "nom"
						}
					]
				},
				{
					"type": "text",
					"text": " — unique dans l'espace de travail — puis son\n"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "objet"
						}
					]
				},
				{
					"type": "text",
					"text": ". L'objet y est montré "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "tel qu'il est écrit"
						}
					]
				},
				{
					"type": "text",
					"text": ", trous compris : la liste n'est pas une\nprévisualisation, et elle n'a pas d'affaire sur laquelle remplir les trous."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "ecrire-un-modele",
			"content": [
				{
					"type": "text",
					"text": "7.1 Écrire un modèle"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "« Nouveau modèle » ouvre la fiche, sous la liste — jamais dans une fenêtre qui recouvrirait l'écran.\nTrois champs : le "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "nom"
						}
					]
				},
				{
					"type": "text",
					"text": ", l'"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "objet"
						}
					]
				},
				{
					"type": "text",
					"text": " et le "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "corps du message"
						}
					]
				},
				{
					"type": "text",
					"text": "."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Les variables disponibles sont proposées sous le corps"
						}
					]
				},
				{
					"type": "text",
					"text": ", en douze boutons. Un clic insère la\nvariable "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "à l'endroit du curseur"
						}
					]
				},
				{
					"type": "text",
					"text": ", dans le champ que vous venez de quitter — l'objet ou le corps.\nVous pouvez aussi les taper à la main : rien ne vous en empêche."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Une variable qui n'existe pas est refusée"
						}
					]
				},
				{
					"type": "text",
					"text": ", et le produit dit "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "dans quel champ"
						}
					]
				},
				{
					"type": "text",
					"text": " elle se trouve :\n« L'objet emploie une variable qui n'existe pas ». C'est le serveur qui refuse, pas l'écran — ce qui\nsignifie que la faute ne peut pas passer par un autre chemin et se découvrir chez le destinataire.\nVotre saisie n'est pas effacée : corrigez la variable et réenregistrez."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Les autres refus sont dits de la même façon : un nom de plus de 120 caractères, un objet de plus de\n300, un corps de plus de 20 000, ou un nom déjà employé par un autre modèle."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "previsualiser-un-modele-sur-une-affaire-reelle",
			"content": [
				{
					"type": "text",
					"text": "7.2 Prévisualiser un modèle sur une affaire réelle"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "« Prévisualiser », sur la ligne d'un modèle, ouvre un panneau à trois choix :"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "l'affaire"
									}
								]
							},
							{
								"type": "text",
								"text": " — obligatoire. Aucune n'est choisie d'avance : le produit ne devine pas de quelle\naffaire vous voulez parler ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "le contact"
									}
								]
							},
							{
								"type": "text",
								"text": " — facultatif. La liste porte "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "tous"
									}
								]
							},
							{
								"type": "text",
								"text": " les contacts que vous pouvez lire, et pas\nseulement ceux qui sont rattachés à l'affaire choisie ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "l'identité d'expédition"
									}
								]
							},
							{
								"type": "text",
								"text": " — facultative. Aucune n'est choisie d'avance non plus : plusieurs\nidentités peuvent être « par défaut », chacune pour une personne, et le produit ne tranche pas à\nvotre place."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "« Prévisualiser » affiche alors l'"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "objet"
						}
					]
				},
				{
					"type": "text",
					"text": " et le "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "corps"
						}
					]
				},
				{
					"type": "text",
					"text": " exactement tels qu'ils partiront, retours\nà la ligne compris."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Les trous sans valeur sont NOMMÉS."
						}
					]
				},
				{
					"type": "text",
					"text": " Si l'affaire n'a pas de montant, ou si vous n'avez choisi\naucune identité, le produit rend ces trous "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "vides"
						}
					]
				},
				{
					"type": "text",
					"text": " — jamais un tiret, qui se lirait comme une\nvaleur — et l'écrit sous le message : « 2 variables sans valeur », suivi de la liste des variables\nconcernées, dans la graphie exacte que vous avez tapée. C'est ce qui vous permet de voir le manque\n"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "avant"
						}
					]
				},
				{
					"type": "text",
					"text": " l'envoi, plutôt que le destinataire après."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Quand toutes les variables employées ont une valeur, "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "rien n'est affiché"
						}
					]
				},
				{
					"type": "text",
					"text": " : l'absence de message\ndit déjà que tout est rempli."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Si aucune affaire n'est choisie"
						}
					]
				},
				{
					"type": "text",
					"text": ", ou si l'affaire choisie ne vous est plus lisible, le produit\nécrit « Aucun rendu : choisissez une affaire, ou l'affaire choisie n'est plus lisible ». Les deux\ncauses sont volontairement dites ensemble : les distinguer révélerait l'existence d'affaires que vos\ndroits vous cachent."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "supprimer-un-modele",
			"content": [
				{
					"type": "text",
					"text": "7.3 Supprimer un modèle"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Le bouton vit "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "dans la fiche"
						}
					]
				},
				{
					"type": "text",
					"text": " du modèle, et non sur sa ligne : un geste qui détruit ne se déclenche\npas depuis une liste qu'on parcourt du regard. Il demande une confirmation qui "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "nomme"
						}
					]
				},
				{
					"type": "text",
					"text": " le modèle et\ndit ce qui est perdu : « Le texte du modèle est définitivement perdu. »"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Il n'y a "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "pas de corbeille"
						}
					]
				},
				{
					"type": "text",
					"text": " pour un modèle : il ne contient aucun travail, c'est un texte. Une fois\nsupprimé, il faut le réécrire."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "ce-qui-n-est-pas-encore-offert",
			"content": [
				{
					"type": "text",
					"text": "7.4 Ce qui n'est pas encore offert"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Aucun envoi depuis cet écran."
									}
								]
							},
							{
								"type": "text",
								"text": " La prévisualisation montre ; elle n'expédie rien. Composer un\nmessage à partir d'un modèle viendra avec les séquences de relance."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "deleted",
								"content": [
									{
										"type": "strong",
										"content": [
											{
												"type": "text",
												"text": "Aucune signature."
											}
										]
									}
								]
							},
							{
								"type": "text",
								"text": " "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Livrée"
									}
								]
							},
							{
								"type": "text",
								"text": " — voir le chapitre "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "7 bis"
									}
								]
							},
							{
								"type": "text",
								"text": " ci-dessous. Une identité\nd'expédition porte désormais sa signature, ajoutée à la fin de chaque message expédié depuis elle."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Aucune séquence de relance."
									}
								]
							},
							{
								"type": "text",
								"text": " Les paliers — un modèle, un délai, puis le suivant — ne sont pas\nlivrés."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Les dates sont rendues en UTC."
									}
								]
							},
							{
								"type": "text",
								"text": " Une échéance affichée « 16/08/2026 09:00 » dans un message est\nexprimée en temps universel : le produit ne connaît pas encore le fuseau de votre espace de\ntravail. Un destinataire français lira donc 09:00 là où le rendez-vous est à 11:00 en heure d'été."
							}
						]
					}
				]
			]
		}
	]
}
