{
	"slug": "les-objectifs-le-tableau-blanc-de-l-equipe",
	"title": "8. Les objectifs : le tableau blanc de l'équipe",
	"blocks": [
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "L'entrée "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Objectifs"
						}
					]
				},
				{
					"type": "text",
					"text": " de la barre latérale ouvre les "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "tableaux d'objectifs"
						}
					]
				},
				{
					"type": "text",
					"text": " de votre espace de travail. Un tableau est\nun "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "tableau blanc"
						}
					]
				},
				{
					"type": "text",
					"text": " : vous y posez des "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "blocs"
						}
					]
				},
				{
					"type": "text",
					"text": " — un objectif chacun —, vous les reliez par des "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "flèches"
						}
					]
				},
				{
					"type": "text",
					"text": " pour dire ce\nqui nourrit quoi, et vous indiquez sur chaque bloc où vous en êtes."
				}
			]
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/canevas.jpg",
			"alt": "Le tableau d'objectifs : ses blocs reliés par des flèches, et la liste des liens du diagramme en dessous",
			"width": 1440,
			"height": 900
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Le remplissage d'un bloc est saisi à la main, jamais calculé."
						}
					]
				},
				{
					"type": "text",
					"text": " Un bloc peut viser un channel, mais le produit ne\ndéduit rien des affaires de ce channel : c'est vous qui décidez de ce que le pourcentage signifie, et vous qui le\ntenez à jour. La fiche du bloc le rappelle sous son remplissage."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "la-liste-des-tableaux",
			"content": [
				{
					"type": "text",
					"text": "8.1 La liste des tableaux"
				}
			]
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/liste.jpg",
			"alt": "La liste des tableaux d'objectifs, avec la case des archivés et les commandes de chaque tableau",
			"width": 1192,
			"height": 229
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/tableau-archive.jpg",
			"alt": "Un tableau archivé dans la liste, avec sa pilule Archivé et la commande qui le désarchive",
			"width": 1158,
			"height": 129
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/refus-de-creation.jpg",
			"alt": "Le formulaire de création d'un tableau, refusé à un membre qui n'administre pas l'espace",
			"width": 1158,
			"height": 273
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "L'écran "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Tableaux d'objectifs »"
						}
					]
				},
				{
					"type": "text",
					"text": " liste les tableaux de l'espace dans leur ordre, chacun avec sa description et son\nnombre de blocs. Cliquer sur le nom d'un tableau ouvre son canevas."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Un "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "administrateur"
						}
					]
				},
				{
					"type": "text",
					"text": " ou un "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "business developer"
						}
					]
				},
				{
					"type": "text",
					"text": " de l'espace administre les tableaux depuis cette liste :"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Créer un tableau »"
									}
								]
							},
							{
								"type": "text",
								"text": " ouvre un formulaire dans la page — un "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Nom"
									}
								]
							},
							{
								"type": "text",
								"text": ", obligatoire et unique dans l'espace, et une\n"
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Description"
									}
								]
							},
							{
								"type": "text",
								"text": " facultative ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Renommer »"
									}
								]
							},
							{
								"type": "text",
								"text": " change le nom et la description d'un tableau ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Monter »"
									}
								]
							},
							{
								"type": "text",
								"text": " et "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Descendre »"
									}
								]
							},
							{
								"type": "text",
								"text": " changent son rang, d'un cran à la fois ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Archiver »"
									}
								]
							},
							{
								"type": "text",
								"text": " retire un tableau de la liste, après une confirmation qui le nomme. Rien n'est perdu : la case\n"
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Afficher les archivés »"
									}
								]
							},
							{
								"type": "text",
								"text": " le fait reparaître avec la mention "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Archivé »"
									}
								]
							},
							{
								"type": "text",
								"text": " et la seule commande\n"
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "« Désarchiver »"
									}
								]
							},
							{
								"type": "text",
								"text": ". Un tableau archivé garde son nom : un autre tableau ne peut pas le prendre tant qu'il existe."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Pour un autre compte, le serveur refuse ces gestes, et l'écran le dit sous la commande : "
				},
				{
					"type": "emphasis",
					"content": [
						{
							"type": "text",
							"text": "« Vous ne pouvez pas\nadministrer les tableaux de cet espace de travail. »"
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "le-canevas",
			"content": [
				{
					"type": "text",
					"text": "8.2 Le canevas"
				}
			]
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/commandes-du-canevas.jpg",
			"alt": "Les commandes du canevas : retour aux tableaux, poser un bloc, tracer une flèche et le zoom",
			"width": 644,
			"height": 73
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/un-bloc.jpg",
			"alt": "Un bloc : son titre, sa barre de remplissage et le channel qu'il vise",
			"width": 292,
			"height": 173
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/lien-perdu.jpg",
			"alt": "Un bloc dont le channel visé n'existe plus, marqué Lien perdu",
			"width": 272,
			"height": 153
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/liens-du-diagramme.jpg",
			"alt": "La liste des liens du diagramme, chacun avec son sens et sa commande de suppression",
			"width": 1192,
			"height": 213
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/extremite-hors-de-portee.jpg",
			"alt": "Un lien dont une extrémité est un bloc que la lectrice ne lit pas",
			"width": 1192,
			"height": 73
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Le canevas d'un tableau se "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "déplace"
						}
					]
				},
				{
					"type": "text",
					"text": " — faites-le glisser — et se "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "zoome"
						}
					]
				},
				{
					"type": "text",
					"text": " avec les boutons "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Réduire le canevas »"
						}
					]
				},
				{
					"type": "text",
					"text": "\net "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Agrandir le canevas »"
						}
					]
				},
				{
					"type": "text",
					"text": ", la valeur courante affichée entre les deux. "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Retour aux tableaux »"
						}
					]
				},
				{
					"type": "text",
					"text": " ramène à la\nliste."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Chaque "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "bloc"
						}
					]
				},
				{
					"type": "text",
					"text": " porte son "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "titre"
						}
					]
				},
				{
					"type": "text",
					"text": ", deux lignes de son "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "corps"
						}
					]
				},
				{
					"type": "text",
					"text": " s'il en a un, sa "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "jauge"
						}
					]
				},
				{
					"type": "text",
					"text": " — « Remplissage 40 % », par\nexemple — et, s'il vise un channel, une "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "pilule « Track › Channel »"
						}
					]
				},
				{
					"type": "text",
					"text": " : cliquer dessus "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "ouvre le channel"
						}
					]
				},
				{
					"type": "text",
					"text": ". Une\n"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "flèche"
						}
					]
				},
				{
					"type": "text",
					"text": " relie deux blocs ; elle a un sens — du départ vers l'arrivée, de l'arrivée vers le départ, ou dans les deux\nsens — et parfois un libellé, posé en son milieu."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Sous le canevas, "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Liens du diagramme »"
						}
					]
				},
				{
					"type": "text",
					"text": " donne l'équivalent textuel de toutes les flèches, une par ligne — c'est ce\nque lit un lecteur d'écran, et c'est la façon la plus sûre de vérifier ce qui relie quoi."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Ce que vous ne voyez pas, et pourquoi."
						}
					]
				},
				{
					"type": "text",
					"text": " Un bloc qui vise un channel que vous n'avez pas le droit de lire "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "n'est pas\naffiché du tout"
						}
					]
				},
				{
					"type": "text",
					"text": " ; ses flèches sont dessinées en pointillés vers le vide, et la liste textuelle les écrit vers une\n"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« extrémité hors de portée »"
						}
					]
				},
				{
					"type": "text",
					"text": ". L'écran ne nomme jamais ce qu'il vous cache. Un bloc dont le channel a été "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "mis à la\ncorbeille"
						}
					]
				},
				{
					"type": "text",
					"text": " reste affiché, sans pilule, avec la mention "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Lien perdu »"
						}
					]
				},
				{
					"type": "text",
					"text": " : reposez-lui un lien. Si le channel a été\n"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "détruit"
						}
					]
				},
				{
					"type": "text",
					"text": " définitivement, le bloc redevient un bloc libre, sans mention — rien ne permet plus de savoir qu'il visait\nun channel."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "poser-deplacer-et-modifier-un-bloc",
			"content": [
				{
					"type": "text",
					"text": "8.3 Poser, déplacer et modifier un bloc"
				}
			]
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/poser-un-bloc.jpg",
			"alt": "La pose d'un bloc en cours : la consigne au-dessus du canevas et la commande pour annuler la pose",
			"width": 1192,
			"height": 111
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/fiche-du-bloc.jpg",
			"alt": "La fiche d'un bloc nouvellement posé : son titre, l'état Enregistré et la commande qui ferme la fiche",
			"width": 1158,
			"height": 203
		},
		{
			"type": "image",
			"src": "les-objectifs-le-tableau-blanc-de-l-equipe/channel-vise.jpg",
			"alt": "Dans la fiche d'un bloc, le channel visé et la commande qui retire le lien",
			"width": 1158,
			"height": 73
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "« Poser un bloc »"
						}
					]
				},
				{
					"type": "text",
					"text": " fait apparaître un repère : cliquez sur le canevas à l'endroit voulu, ou, au clavier, déplacez le\nrepère avec les flèches, validez par Entrée et annulez par Échap. Le bloc naît avec un titre provisoire, et sa fiche\ns'ouvre pour que vous le nommiez."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Un bloc se "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "déplace"
						}
					]
				},
				{
					"type": "text",
					"text": " et se "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "redimensionne"
						}
					]
				},
				{
					"type": "text",
					"text": " à la souris — en le faisant glisser, ou par sa poignée d'angle — ou au\nclavier, le bloc ayant le focus : les flèches le déplacent, "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Maj"
						}
					]
				},
				{
					"type": "text",
					"text": " et les flèches l'ajustent au pixel, "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Alt"
						}
					]
				},
				{
					"type": "text",
					"text": " et les\nflèches le redimensionnent. "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Entrée"
						}
					]
				},
				{
					"type": "text",
					"text": " ouvre sa "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "fiche"
						}
					]
				},
				{
					"type": "text",
					"text": " :"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Titre"
									}
								]
							},
							{
								"type": "text",
								"text": " — obligatoire : un bloc sans titre ne se lit pas ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Corps"
									}
								]
							},
							{
								"type": "text",
