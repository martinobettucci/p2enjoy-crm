			"content": [
				{
					"type": "text",
					"text": "13.1 Ce qui n'est pas encore là"
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Aucune alerte n'est envoyée"
									}
								]
							},
							{
								"type": "text",
								"text": " lorsqu'un compte tombe en erreur : cet écran est le seul endroit où\nle constater."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "La relève n'est pas instantanée"
									}
								]
							},
							{
								"type": "text",
								"text": " : elle a lieu à intervalles réguliers, fixés à l'installation du CRM et non\ndepuis cet écran. Un message arrivé dans votre boîte paraît dans le CRM au passage suivant."
							}
						]
					}
				]
			]
		}
	]
