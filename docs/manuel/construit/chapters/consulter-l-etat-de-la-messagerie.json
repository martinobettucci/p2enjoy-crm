						{
							"type": "text",
							"text": "Qui."
						}
					]
				},
				{
					"type": "text",
					"text": " Un administrateur de l'espace de travail voit "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "tous"
						}
					]
				},
				{
					"type": "text",
					"text": " les comptes de messagerie entrante\ndu workspace, la boîte système comprise. Un membre ordinaire ne voit que "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "sa propre boîte"
						}
					]
				},
				{
					"type": "text",
					"text": ", s'il en\npossède une ; sans boîte propre et sans droit d'administration, l'écran affiche « Aucune boîte à\nsuperviser » plutôt qu'un tableau vide qui prétendrait avoir cherché sans rien trouver."
				}
			]
		},
		{
			"type": "image",
			"src": "consulter-l-etat-de-la-messagerie/aucune-boite.jpg",
			"alt": "L'état vide « Aucune boîte à superviser »",
			"width": 548,
			"height": 212
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Ce que le tableau montre, par boîte :"
						}
					]
				}
			]
		},
		{
			"type": "list",
			"ordered": false,
			"start": null,
			"items": [
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Dernière relève réussie"
									}
								]
							},
							{
								"type": "text",
								"text": " — la date et l'heure du dernier relevé qui a abouti. Une boîte jamais\nrelevée l'annonce en toutes lettres : « Jamais relevée », et non une case vide."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Dernier incident"
									}
								]
							},
							{
								"type": "text",
								"text": " — si la boîte est en échec, un texte compréhensible : « Authentification\nrefusée », « Hôte injoignable », « Connexion refusée », « Échec TLS », « Délai dépassé » ou\n« Erreur de protocole ». Le produit ne montre jamais le message technique brut renvoyé par votre\nserveur mail, qui peut contenir des détails de connexion."
							}
						]
					}
				]
			]
		},
