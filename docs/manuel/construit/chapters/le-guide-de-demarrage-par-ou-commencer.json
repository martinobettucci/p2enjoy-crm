						},
						{
							"type": "code",
							"text": "docs/captures/CRM-095/"
						},
						{
							"type": "text",
							"text": "."
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "À la première connexion, l'accueil ne montre aucun board — il n'y en a pas encore. Il montre à la\nplace le "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Guide de démarrage"
						}
					]
				},
				{
					"type": "text",
					"text": ", une liste de "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "six étapes"
						}
					]
				},
				{
					"type": "text",
					"text": " qui mènent chacune vers l'écran qui\nla réalise."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Les six étapes, dans l'ordre :"
				}
			]
		},
		{
			"type": "table",
			"align": [
				null,
				null,
				null
			],
			"header": [
