								]
							},
							{
								"type": "text",
								"text": ", sans recharger."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Le refermer"
									}
								]
							},
							{
								"type": "text",
								"text": " : le bouton "
