								]
							},
							{
								"type": "text",
								"text": " la retire jusqu'à la fermeture de\nl'onglet — c'est la même préférence que "
							},
							{
								"type": "emphasis",
								"content": [
									{
										"type": "text",
										"text": "Masquer le guide"
									}
								]
							},
							{
								"type": "text",
								"text": "."
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Ce qu'il retient"
									}
								]
							},
							{
								"type": "text",
								"text": " : ouvert ou réduit, pour la durée de l'onglet seulement ; rien d'autre, et\nrien de durable sur votre appareil."
