							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Fait"
									}
								]
							},
							{
								"type": "text",
								"text": ", le bouton disparaît, et le curseur du\nclavier se place sur le lien "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Ouvrir l'éditeur de workflows"
									}
								]
							},
							{
								"type": "text",
								"text": " de la même ligne ; un lecteur\nd'écran annonce « Workflow de départ créé » ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "si un workflow existe déjà — créé entre-temps dans un autre onglet, ou par un collègue —, l'étape\npasse aussi à "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Fait"
									}
								]
							},
							{
								"type": "text",
								"text": ", et l'annonce dit « Cet espace a déjà un workflow : ouvrez l'éditeur pour\nle composer. » Ce n'est pas une erreur ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "si un nœud du cycle type a été "
							},
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "archivé"
									}
								]
							},
							{
								"type": "text",
								"text": " dans le catalogue, la création est refusée et le\nmessage nomme ce nœud : restaurez-le depuis "
