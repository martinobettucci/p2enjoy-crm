							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Réduire"
									}
								]
							},
							{
								"type": "text",
								"text": ", la touche "
							},
							{
								"type": "code",
								"text": "Échap"
							},
							{
								"type": "text",
								"text": ", ou un nouveau clic sur la pastille.\nLe focus revient sur la pastille. "
							},
							{
