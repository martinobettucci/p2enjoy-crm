							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "vue liste"
									}
								]
							},
							{
								"type": "text",
								"text": " les range par leurs colonnes, dans un channel — « laquelle dois-je ouvrir ? » ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Ma journée"
									}
								]
							},
							{
								"type": "text",
								"text": " les range par échéance, partout — « qu'est-ce qui est en retard ? »."
							}
						]
					}
				]
			]
		},
