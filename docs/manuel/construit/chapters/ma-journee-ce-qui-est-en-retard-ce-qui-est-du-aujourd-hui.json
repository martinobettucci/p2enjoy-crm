				{
					"type": "text",
					"text": " de la barre latérale répond à une seule question : "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "que dois-je faire\naujourd'hui ?"
						}
					]
				},
				{
					"type": "text",
					"text": " Elle rassemble les affaires qui portent une "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "échéance"
						}
					]
				},
				{
