						"content": [
							{
								"type": "strong",
								"content": [
									{
										"type": "text",
										"text": "Tout l'espace de travail"
									}
								]
							},
							{
								"type": "text",
								"text": " : toutes celles que vos droits vous laissent lire."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Le choix vit dans l'"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "adresse"
						}
					]
				},
				{
					"type": "text",
					"text": " de la page : une adresse copiée à un collègue lui montre donc ce que vous voyez — sous\nréserve de ses propres droits, qui restent seuls juges de ce qu'il peut lire."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Élargir la portée n'ouvre rien."
						}
					]
				},
				{
					"type": "text",
					"text": " Ce que vous voyez reste ce que le serveur vous consent : une\naffaire d'un track qui vous est fermé n'apparaît dans aucune des deux portées, et l'écran ne la\nnomme jamais."
				}
			]
		},
		{
