			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "C'est la troisième façon de lire vos affaires, et elle range par le "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "temps"
						}
					]
				},
				{
					"type": "text",
					"text": " :"
				}
			]
		},
