								"content": [
									{
										"type": "text",
										"text": "tableau"
									}
								]
							},
							{
								"type": "text",
								"text": " d'un channel les range par étape du processus — « où en est chaque affaire ? » ;"
							}
						]
					}
				],
				[
					{
						"type": "paragraph",
						"content": [
							{
								"type": "text",
								"text": "la "
