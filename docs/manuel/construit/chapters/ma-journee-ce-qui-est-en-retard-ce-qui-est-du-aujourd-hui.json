			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "L'écran se lit de haut en bas, en trois sections, et chacune écrit "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "combien"
						}
					]
				},
				{
					"type": "text",
					"text": " d'affaires elle\nporte :"
				}
			]
		},
		{
			"type": "table",
			"align": [
				null,
