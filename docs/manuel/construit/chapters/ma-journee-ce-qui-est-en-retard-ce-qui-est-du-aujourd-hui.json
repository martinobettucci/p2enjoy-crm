						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "à la corbeille"
								}
							]
						}
					],
					[
						{
							"type": "text",
							"text": "Elles ne sont plus en cours ("
						},
						{
							"type": "link",
							"target": {
								"chapter": "l-affaire-ce-qu-elle-porte-son-adresse-ses-deux-facons-de-disparaitre",
