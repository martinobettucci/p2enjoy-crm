				],
				[
					[
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "Aujourd'hui"
								}
							]
						}
					],
					[
						{
							"type": "text",
							"text": "Les échéances du jour, de minuit à minuit, dans le fuseau horaire de "
						},
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "votre"
								}
							]
						},
						{
							"type": "text",
							"text": " appareil"
						}
					]
				],
				[
					[
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "À venir"
								}
							]
						}
					],
					[
						{
							"type": "text",
							"text": "Les échéances des "
						},
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "sept prochains jours"
								}
							]
						},
						{
							"type": "text",
							"text": ", pas au-delà"
						}
					]
				]
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Une section sans affaire n'est pas affichée."
						}
					]
				},
				{
					"type": "text",
					"text": " Trois titres surmontant trois vides diraient trois\nfois « rien » ; leur absence le dit une fois."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "L'horizon est de sept jours, et il n'est pas réglable."
						}
					]
				},
				{
					"type": "text",
					"text": " Au-delà, ce ne serait plus une journée :\nc'est la vue liste d'un channel, triée par échéance, qui répond à cette question-là."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "ce-qu-une-ligne-montre",
			"content": [
				{
					"type": "text",
					"text": "6.2 Ce qu'une ligne montre"
				}
			]
		},
		{
			"type": "image",
			"src": "ma-journee-ce-qui-est-en-retard-ce-qui-est-du-aujourd-hui/une-ligne.jpg",
			"alt": "Une ligne de la journée : l'échéance en rouge, l'affaire, sa prochaine action et son channel",
			"width": 1190,
			"height": 73
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Chaque ligne porte, dans cet ordre : l'"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "échéance"
						}
					]
				},
				{
					"type": "text",
					"text": " avec son heure, le "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "titre"
						}
					]
				},
				{
					"type": "text",
					"text": " de l'affaire — qui\nest un lien vers sa fiche —, la "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "prochaine action"
						}
					]
				},
				{
					"type": "text",
					"text": " à mener, et la "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "situation"
						}
					]
				},
				{
					"type": "text",
					"text": " de l'affaire sous\nla forme « Track › Channel », elle-même un lien qui ouvre le dossier."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "L'échéance vient en tête parce que c'est elle qui range l'écran : une colonne de dates alignées se\nlit d'un seul regard. "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "L'heure est toujours affichée"
						}
					]
				},
				{
					"type": "text",
					"text": " — une échéance du jour sans heure ne dirait\npas si la matinée est déjà passée."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "text",
					"text": "Dans la section "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "En retard"
						}
					]
				},
				{
					"type": "text",
					"text": ", et là seulement, l'échéance est teintée de rouge. La teinte porte sur\nla "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "date"
						}
					]
				},
				{
					"type": "text",
					"text": ", jamais sur la ligne entière : une affaire en retard est un travail à faire, pas une\nerreur."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Une affaire peut porter une échéance sans prochaine action écrite."
						}
					]
				},
				{
					"type": "text",
					"text": " La colonne reste alors vide —\nni tiret, ni « non renseigné ». L'échéance seule est déjà une information."
				}
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "mes-affaires-ou-tout-l-espace-de-travail",
			"content": [
