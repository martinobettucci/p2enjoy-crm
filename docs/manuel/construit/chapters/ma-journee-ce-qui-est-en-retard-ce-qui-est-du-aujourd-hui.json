							},
							"content": [
								{
									"type": "text",
									"text": "section 9.4"
								}
							]
						},
						{
							"type": "text",
							"text": ")"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "Les affaires "
						},
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "en sommeil"
								}
							]
						}
					],
					[
						{
							"type": "text",
							"text": "Les endormir est précisément le geste qui dit « pas aujourd'hui » ("
						},
						{
							"type": "link",
							"target": {
								"chapter": "l-affaire-ce-qu-elle-porte-son-adresse-ses-deux-facons-de-disparaitre",
								"anchor": "mettre-une-affaire-en-sommeil-et-la-retrouver"
							},
							"content": [
								{
									"type": "text",
									"text": "section 9.13"
								}
							]
						},
						{
							"type": "text",
							"text": "). Elles restent visibles dans leur tableau et leur vue liste, où une case à cocher les ramène"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "Les affaires "
						},
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "sans échéance"
								}
							]
						}
					],
					[
						{
							"type": "text",
							"text": "Il n'y a rien à ranger dans une journée"
						}
					]
				],
				[
					[
						{
							"type": "text",
							"text": "Les échéances au-delà de "
						},
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "sept jours"
								}
							]
						}
					],
					[
						{
							"type": "text",
							"text": "Voir l'horizon ci-dessus"
						}
					]
				]
			]
		},
		{
			"type": "heading",
			"level": 3,
			"anchor": "ce-que-l-ecran-ne-fait-pas",
			"content": [
				{
					"type": "text",
					"text": "6.5 Ce que l'écran ne fait pas"
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Il lit, il n'écrit pas."
						}
					]
				},
				{
					"type": "text",
					"text": " Aucun bouton n'y reporte une échéance, ne coche « fait » ni ne saisit une\nprochaine action. Ces deux valeurs se modifient à un seul endroit — l'"
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "en-tête de la fiche"
						}
					]
				},
				{
					"type": "text",
					"text": " de\nl'affaire ("
				},
				{
					"type": "link",
					"target": {
						"chapter": "l-affaire-ce-qu-elle-porte-son-adresse-ses-deux-facons-de-disparaitre",
						"anchor": "la-fiche-d-une-affaire-son-en-tete-son-formulaire-et-ce-qu-ils-montrent"
					},
					"content": [
						{
							"type": "text",
							"text": "section 9.6"
						}
					]
				},
				{
					"type": "text",
					"text": ") —, et le rester est ce qui évite deux façons de faire la même chose."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Ce n'est pas un agenda"
						}
					]
				},
				{
					"type": "text",
					"text": " : ni créneau, ni durée, ni rendez-vous, ni récurrence. Une affaire porte\nun instant, pas une plage."
				}
			]
		},
		{
			"type": "paragraph",
			"content": [
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "Ce n'est pas la liste des relances."
						}
					]
				},
				{
					"type": "text",
					"text": " Une affaire peut stagner dans son étape au-delà de son seuil\nde relance sans porter aucune échéance, et l'inverse. La "
				},
				{
					"type": "strong",
					"content": [
						{
							"type": "text",
							"text": "pastille d'ancienneté"
						}
					]
				},
				{
					"type": "text",
					"text": " du tableau\n("
				},
