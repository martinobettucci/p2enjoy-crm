									"text": "§30.2"
								}
							]
						},
						{
							"type": "text",
							"text": ").\nC'est le "
						},
						{
							"type": "strong",
							"content": [
								{
									"type": "text",
									"text": "chapitre 28"
								}
							]
						},
						{
							"type": "text",
							"text": " que "
						},
						{
							"type": "code",
							"text": "docs/SPEC-analytique.md"
						},
						{
							"type": "text",
							"text": " nomme. Captures dans\n"
						},
						{
							"type": "code",
							"text": "docs/captures/CRM-066/pilotage-*.jpg"
						},
						{
							"type": "text",
