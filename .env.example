# @spec CRM-002 (docs/BACKLOG.md) — gabarit documenté de l'environnement
# @spec CRM-015 (docs/BACKLOG.md) — CA facultative du registre npm au build de développement
# @spec docs/JOURNAL.md décision 15 (liste exhaustive des variables de l'assemblage), décision 16
# @spec docs/DAT.md §9 (déploiement), §13 (commandes de lancement)
# @spec docs/PROD_MIGRATIONS.md §2.3 (variables à produire pour la production)
# @spec README.md §4 (installation), §9 (variables d'environnement)
#
# ---------------------------------------------------------------------------------------------
# CE FICHIER EST UN GABARIT. IL NE CONTIENT AUCUN SECRET RÉEL.
# ---------------------------------------------------------------------------------------------
#
# Chaque variable est documentée sur la ligne qui la précède : rôle, format attendu, caractère
# obligatoire, et valeur d'exemple non sensible.
#
# Deux conventions gouvernent ce fichier, et les scripts s'appuient dessus :
#
#   * Une valeur `CHANGE_ME_*` est un **secret ou un paramètre propre au site** : elle doit être
#     remplacée avant tout démarrage. `./runDev.sh` les remplace automatiquement par des valeurs
#     tirées au hasard lors du premier amorçage ; `./runProd.sh` **refuse** de démarrer tant
#     qu'il en reste une.
#   * Une valeur **vide** ici signale une variable facultative, qui peut légitimement rester vide.
#     Toute autre variable doit être renseignée.
#
# Usage :
#   ./runDev.sh                 amorce `.env` depuis ce gabarit s'il est absent, puis démarre
#   cp .env.example .env        amorçage manuel, à compléter à la main
#
# `.env` n'est jamais versionné (voir `.gitignore`).

# =============================================================================================
# 1. Profil d'environnement
# =============================================================================================

# Environnement visé par ce fichier. Garde de sécurité des scripts : `./runProd.sh` refuse un
# fichier de profil `dev`, et `./resetMe.sh`, qui détruit les données, refuse un profil `prod`.
# Format : `dev` ou `prod`. Requise : oui.
P2ENJOY_ENV_PROFILE=dev

# =============================================================================================
# 2. Base de données
# =============================================================================================

# Nom d'hôte de PostgreSQL sur le réseau de la pile. Format : nom de service Compose.
# Requise : oui.
POSTGRES_HOST=db

# Port PostgreSQL **interne** à la pile. Format : entier 1-65535. Requise : oui.
POSTGRES_PORT=5432

# Base de données applicative. Format : identifiant PostgreSQL. Requise : oui.
POSTGRES_DB=postgres

# Mot de passe du superutilisateur PostgreSQL, et de tous les rôles de service de la pile.
# Format : chaîne sans espace ni caractère d'échappement, 32 caractères ou plus. Requise : oui.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Port publié sur l'hôte pour l'accès SQL direct (pgTAP, outillage de migration).
# **Développement uniquement** : la production ne publie aucun port PostgreSQL.
# Format : entier 1-65535. Requise : oui en développement.
POSTGRES_DIRECT_PORT=54322

# =============================================================================================
# 3. Jetons et secrets
# =============================================================================================
# Aucune de ces valeurs ne doit être partagée entre deux environnements. Celles de production
# sont produites séparément (docs/PROD_MIGRATIONS.md §2.3).

# Secret de signature HS256 des jetons Supabase. `ANON_KEY` et `SERVICE_ROLE_KEY` en sont
# dérivées : changer ce secret invalide les deux clés.
# Format : chaîne d'au moins 32 caractères. Requise : oui.
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Durée de validité d'un jeton d'accès, en secondes. Format : entier. Requise : oui.
JWT_EXPIRY=3600

# Clé d'API publique, portée par le navigateur. JWT HS256 signé par `JWT_SECRET`, de rôle `anon`.
# Format : JWT. Requise : oui.
ANON_KEY=CHANGE_ME_ANON_KEY

# Clé d'API de service, qui **contourne la RLS**. Elle ne quitte jamais le serveur et n'est
# jamais exposée au navigateur. JWT HS256 signé par `JWT_SECRET`, de rôle `service_role`.
# Format : JWT. Requise : oui.
SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY

# Secret de session de Realtime (Phoenix). Format : 64 caractères exactement.
# Requise : oui.
SECRET_KEY_BASE=CHANGE_ME_SECRET_KEY_BASE

# Clé de chiffrement interne de Realtime. Format : **16 caractères exactement** — Realtime refuse
# de démarrer avec une autre longueur. Requise : oui.
REALTIME_DB_ENC_KEY=CHANGE_ME_REALTIME_DB_ENC_KEY

# Clé de chiffrement des identifiants stockés par Studio et `postgres-meta`.
# Format : 32 caractères exactement. Requise : oui.
PG_META_CRYPTO_KEY=CHANGE_ME_PG_META_CRYPTO_KEY

# =============================================================================================
# 4. Clés opaques (facultatives)
# =============================================================================================
# Nouveau format de clés Supabase, accepté par la passerelle en plus des JWT. Le produit ne les
# utilise pas : elles restent vides tant qu'aucune unité de backlog ne les exige.

# Clé publique opaque. Format : `sb_publishable_...`. Requise : non.
SUPABASE_PUBLISHABLE_KEY=

# Clé de service opaque. Format : `sb_secret_...`. Requise : non.
SUPABASE_SECRET_KEY=

# Clé anonyme au format asymétrique. Format : JWT signé ES256/RS256. Requise : non.
ANON_KEY_ASYMMETRIC=

# Clé de service au format asymétrique. Format : JWT signé ES256/RS256. Requise : non.
SERVICE_ROLE_KEY_ASYMMETRIC=

# =============================================================================================
# 5. API
# =============================================================================================

# Port de la passerelle Kong publié sur l'hôte. En production, Kong ne publie rien : Caddy le
# joint par le réseau interne. Format : entier 1-65535. Requise : oui.
KONG_HTTP_PORT=8000

# URL par laquelle l'API est jointe depuis l'extérieur. Sert aussi d'émetteur (`iss`) des jetons
# GoTrue. Format : URL absolue sans barre oblique finale. Requise : oui.
# Production : `https://<APP_DOMAIN>`.
API_EXTERNAL_URL=http://localhost:8000

# URL publique du projet, utilisée pour construire les liens de stockage.
# Format : URL absolue sans barre oblique finale. Requise : oui.
SUPABASE_PUBLIC_URL=http://localhost:8000

# URL de la webapp, cible des liens d'invitation et de réinitialisation.
# Format : URL absolue sans barre oblique finale. Requise : oui.
SITE_URL=http://127.0.0.1:5173

# URL de redirection supplémentaires autorisées après authentification.
# Format : liste séparée par des virgules. Requise : oui.
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:5173

# Schémas exposés par PostgREST. Format : liste séparée par des virgules. Requise : oui.
PGRST_DB_SCHEMAS=public,storage,graphql_public

# Nombre maximal de lignes renvoyées par une requête REST sans pagination explicite.
# Format : entier. Requise : non, défaut `1000`.
PGRST_DB_MAX_ROWS=1000

# Chemin de recherche additionnel de PostgREST. Format : liste séparée par des virgules.
# Requise : non, défaut `public`.
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# =============================================================================================
# 6. Authentification
# =============================================================================================

# Inscription libre. **Doit valoir `true`** : les comptes du CRM naissent d'une invitation
# d'administrateur (docs/DAT.md §4.1, unité CRM-011). Format : `true` ou `false`. Requise : oui.
DISABLE_SIGNUP=true

# Autorise le fournisseur « email » — indispensable à l'invitation et à la connexion par mot de
# passe, que `DISABLE_SIGNUP` continue d'encadrer. Format : `true` ou `false`. Requise : oui.
ENABLE_EMAIL_SIGNUP=true

# Confirme l'adresse sans envoi d'email. À laisser `false` : le parcours d'invitation doit être
# éprouvé tel qu'il sera vécu. Format : `true` ou `false`. Requise : oui.
ENABLE_EMAIL_AUTOCONFIRM=false

# Sessions anonymes. Le produit n'en a aucun usage. Format : `true` ou `false`. Requise : oui.
ENABLE_ANONYMOUS_USERS=false

# Authentification par téléphone. Hors périmètre. Format : `true` ou `false`. Requise : oui.
ENABLE_PHONE_SIGNUP=false

# Confirmation implicite du téléphone. Hors périmètre. Format : `true` ou `false`. Requise : oui.
ENABLE_PHONE_AUTOCONFIRM=false

# Longueur minimale d'un mot de passe. Le défaut de GoTrue est 6, mesuré comme réellement
# permissif : un mot de passe de six caractères était accepté (docs/JOURNAL.md décision 29). La
# longueur est le seul critère imposé, sans exigence de composition — les règles de composition
# poussent vers des mots de passe courts, complexes et réutilisés, plus faibles en pratique
# (docs/SPEC-auth.md §4). Format : entier positif. Requise : oui.
PASSWORD_MIN_LENGTH=12

# Chemin de vérification d'une invitation. Format : chemin absolu. Requise : oui.
MAILER_URLPATHS_INVITE=/auth/v1/verify

# Chemin de confirmation d'adresse. Format : chemin absolu. Requise : oui.
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify

# Chemin de réinitialisation de mot de passe. Format : chemin absolu. Requise : oui.
MAILER_URLPATHS_RECOVERY=/auth/v1/verify

# Chemin de changement d'adresse. Format : chemin absolu. Requise : oui.
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# =============================================================================================
# 7. SMTP transactionnel
# =============================================================================================
# Emails émis par la plateforme : invitations, réinitialisations, notifications. En développement
# ils partent vers Inbucket et ne quittent jamais la machine (docs/JOURNAL.md décision 6).
# Rien à voir avec les identités d'envoi des utilisateurs, qui sont saisies dans l'application et
# chiffrées en base.

# Serveur SMTP sortant. Format : nom d'hôte. Requise : oui.
# Production : le fournisseur retenu.
SMTP_HOST=inbucket

# Port SMTP sortant. Format : entier 1-65535. Requise : oui.
SMTP_PORT=2500

# Identifiant SMTP. Vide en développement : Inbucket n'authentifie pas. Format : chaîne.
# Requise : non en développement, oui en production.
SMTP_USER=

# Mot de passe SMTP. Vide en développement. Format : chaîne. Requise : non en développement,
# oui en production. **Jamais versionné.**
SMTP_PASS=

# Adresse d'expédition des emails de la plateforme. Format : adresse email. Requise : oui.
SMTP_ADMIN_EMAIL=crm@exemple.tld

# Nom affiché de l'expéditeur. Format : texte libre. Requise : oui.
SMTP_SENDER_NAME=P2Enjoy CRM

# =============================================================================================
# 8. Stockage objet
# =============================================================================================
# Toujours en mode S3, dans les deux environnements : MinIO en développement, fournisseur réel en
# production (docs/JOURNAL.md décision 13). En développement, l'overlay `docker-compose.dev.yml`
# surcharge l'endpoint et les accès pour viser MinIO : les quatre variables `GLOBAL_S3_*` et
# `AWS_*` ci-dessous décrivent donc la **production**.

# Bucket des pièces jointes. Format : nom de bucket S3. Requise : oui.
GLOBAL_S3_BUCKET=p2enjoy-crm

# Endpoint S3. Format : URL absolue. Requise : oui.
GLOBAL_S3_ENDPOINT=https://s3.exemple.tld

# Protocole de l'endpoint. Format : `http` ou `https`. Requise : oui.
GLOBAL_S3_PROTOCOL=https

# Adressage par chemin plutôt que par sous-domaine. Nécessaire aux fournisseurs compatibles S3.
# Format : `true` ou `false`. Requise : oui.
GLOBAL_S3_FORCE_PATH_STYLE=true

# Identifiant d'accès S3 du service Storage. Format : chaîne. Requise : oui.
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID

# Clé secrète S3 du service Storage. Format : chaîne. Requise : oui. **Jamais versionnée.**
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY

# Identifiant d'accès du protocole S3 **exposé par Supabase Storage** — à ne pas confondre avec
# l'accès au fournisseur ci-dessus. Format : chaîne. Requise : oui.
S3_PROTOCOL_ACCESS_KEY_ID=CHANGE_ME_S3_PROTOCOL_ACCESS_KEY_ID

# Clé secrète du protocole S3 exposé par Storage. Format : chaîne. Requise : oui.
S3_PROTOCOL_ACCESS_KEY_SECRET=CHANGE_ME_S3_PROTOCOL_ACCESS_KEY_SECRET

# Identifiant de tenant du service Storage, préfixe des objets. Format : identifiant court.
# Requise : oui.
STORAGE_TENANT_ID=p2enjoy

# Taille maximale d'un objet, en octets. Format : entier. Requise : oui.
# La borne d'ingestion des pièces jointes est distincte : voir `MAIL_MAX_ATTACHMENT_MB`.
STORAGE_FILE_SIZE_LIMIT=52428800

# Région S3. Format : code de région du fournisseur. Requise : oui.
REGION=local

# =============================================================================================
# 9. Pile
# =============================================================================================

# Nombre de descripteurs de fichiers réclamé par Realtime au démarrage. Sur un hôte dont la limite
# dure (`ulimit -Hn`) est inférieure, le service redémarre en boucle : `./runDev.sh` abaisse alors
# automatiquement la valeur du fichier `.env` amorcé, et le dit. Le défaut valait `100000` tant que
# le pooler Supavisor était de la pile ; c'était sa demande, non celle de Realtime (décision 366).
# Format : entier. Requise : non, défaut `10000`.
STACK_RLIMIT_NOFILE=10000

# Application automatique des migrations de `supabase/migrations/` au démarrage.
# **Doit valoir `false` en production** : le contrat de déploiement fait foi
# (docs/PROD_MIGRATIONS.md). `./runProd.sh` refuse de démarrer si la valeur est `true`.
# Format : `true` ou `false`. Requise : non, défaut `true`.
APPLY_MIGRATIONS=true

# =============================================================================================
# 10. Développement
# =============================================================================================
# Ces variables ne servent qu'à l'overlay `docker-compose.dev.yml`. Aucune n'a d'effet en
# production.

# Interface sur laquelle les ports de développement sont publiés. `127.0.0.1` garde la pile
# inaccessible depuis le réseau. Format : adresse IP. Requise : non, défaut `127.0.0.1`.
DEV_BIND_ADDRESS=127.0.0.1

# Port de Supabase Studio. Format : entier 1-65535. Requise : oui en développement.
STUDIO_PORT=54323

# Port de la webapp servie par Vite en développement (CRM-007, docs/SPEC-webapp.md §12.1).
# Doit correspondre au port de `SITE_URL`, sinon les liens des emails transactionnels — et
# l'acceptation d'une invitation — retomberaient sur une adresse qui n'écoute pas.
# Format : entier 1-65535. Requise : oui en développement.
WEBAPP_DEV_PORT=5173

# Nom d'organisation affiché par Studio. Format : texte libre. Requise : oui en développement.
STUDIO_DEFAULT_ORGANIZATION=P2Enjoy SAS

# Nom de projet affiché par Studio. Format : texte libre. Requise : oui en développement.
STUDIO_DEFAULT_PROJECT=P2Enjoy CRM

# Identifiant d'accès de MinIO, l'équivalent local de S3. Il sert aussi d'`AWS_ACCESS_KEY_ID` au
# service Storage en développement. Format : chaîne d'au moins 3 caractères.
# Requise : oui en développement.
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER

# Clé secrète de MinIO. Format : chaîne d'au moins 8 caractères. Requise : oui en développement.
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD

# Port de l'API S3 de MinIO. Format : entier 1-65535. Requise : oui en développement.
MINIO_API_PORT=9000

# Port de la console web de MinIO. Format : entier 1-65535. Requise : oui en développement.
MINIO_CONSOLE_PORT=9001

# Port de l'interface web d'Inbucket, où se consultent les emails transactionnels.
# Format : entier 1-65535. Requise : oui en développement.
INBUCKET_WEB_PORT=54324

# Port SMTP publié par Inbucket sur l'hôte. Format : entier 1-65535.
# Requise : oui en développement.
INBUCKET_SMTP_PORT=2500

# Chemin **absolu** du paquet PEM d'autorités de certification à fournir à `npm ci` pendant la
# construction de l'image Vite, lorsque le réseau interpose son propre certificat TLS. Le fichier
# reste sur l'hôte et n'entre jamais dans l'image. Vide ou absente d'un ancien `.env`, la variable
# ne change rien au build. Format : chemin absolu vers un fichier PEM lisible. Requise : non.
NPM_CA_FILE=

# Équivalent de `NPM_CA_FILE` pour `pip install` pendant la construction de l'image `mail-sync`
# (décision 356, INC-093). Variable **distincte** et non partagée : les deux chaînes de
# construction ne consomment pas le certificat de la même façon — `npm config set cafile` d'un
# côté, `PIP_CERT` de l'autre. Même contrat : le fichier reste sur l'hôte, n'entre jamais dans
# l'image ni dans le dépôt, et son absence laisse le build strictement inchangé.
# Format : chemin absolu vers un fichier PEM lisible. Requise : non.
PIP_CA_FILE=

# --- Messagerie de développement — CRM-050 ---------------------------------------------------
# Stalwart est le **vrai** serveur IMAP/SMTP local, Roundcube le webmail de contrôle et ClamAV
# l'antivirus. Inbucket reste le puits des emails **transactionnels** : les deux serveurs ne
# servent pas le même usage (docs/SPEC-mail-subsystem.md §11.1). Aucun de ces services n'existe
# en production, où ce sont les serveurs des utilisateurs qui sont lus.

# Port IMAP de Stalwart publié sur l'hôte (conteneur : 143). Format : entier 1-65535.
# Requise : oui en développement.
STALWART_IMAP_PORT=1143

# Port de **remise** SMTP de Stalwart publié sur l'hôte, celui qu'emploierait un serveur
# extérieur pour livrer un message à une adresse de card (conteneur : 25).
# Format : entier 1-65535. Requise : oui en développement.
STALWART_SMTP_PORT=1025

# Port de **soumission** SMTP authentifiée publié sur l'hôte, celui qu'emploient Roundcube et le
# futur `smtp_worker` pour envoyer (conteneur : 587). Format : entier 1-65535.
# Requise : oui en développement.
STALWART_SUBMISSION_PORT=1587

# Port de l'API de gestion de Stalwart publié sur l'hôte (conteneur : 8080). C'est par elle que
# les boîtes sont provisionnées. Format : entier 1-65535. Requise : oui en développement.
STALWART_ADMIN_PORT=8081

# Administrateur de repli de Stalwart. Il n'a pas de boîte : il n'existe que pour l'API de
# gestion. Format : chaîne. Requise : oui en développement.
STALWART_ADMIN_USER=admin

# Mot de passe de cet administrateur. **Tiré au hasard par `runDev.sh` au premier amorçage.**
# Format : chaîne. Requise : oui en développement.
STALWART_ADMIN_PASSWORD=CHANGE_ME_STALWART_ADMIN_PASSWORD

# Mot de passe commun des boîtes de développement. Il ne protège rien et c'est délibéré : les
# adresses sont sous `.test`, les ports ne sont ouverts que sur la boucle locale, et le serveur
# ne contient que des messages de démonstration. C'est le même que celui des comptes seedés
# (docs/SPEC-seed.md §2). Format : chaîne. Requise : oui en développement.
STALWART_MAILBOX_PASSWORD=SeedDev2026Local

# Domaine des adresses **personnelles** des comptes seedés, distinct du domaine des cards.
# Sous `.test`, TLD réservé par la RFC 2606, donc non routable.
# Format : nom de domaine pleinement qualifié. Requise : oui en développement.
MAIL_DEV_PERSONAL_DOMAIN=p2enjoy.test

# Adresse complète de la boîte du **correspondant de démonstration** — CRM-060 sous-tranche 2 bis,
# docs/SPEC-mail-subsystem.md §11.4. Elle n'appartient PAS au produit : aucun compte entrant ne la
# désigne, et le CRM ne relève jamais dedans. Elle existe pour que le seed puisse soumettre un
# message dont le `From` est reconnu comme un **contact** du workspace, seule façon de déclencher
# la règle 3 du classement (docs/SPEC-contacts.md §8.8.8). Son domaine est provisionné à partir de
# cette valeur, et sa partie locale doit correspondre à l'email du contact seedé
# (`docs/SPEC-contacts.md` §5). Sous `.example`, TLD réservé par la RFC 2606, donc non routable.
# Format : adresse email complète. Requise : oui en développement.
MAIL_DEV_CORRESPONDENT_ADDRESS=leo.marchand@sogexia.example

# Port du webmail de contrôle Roundcube. Format : entier 1-65535.
# Requise : oui en développement.
ROUNDCUBE_PORT=8080

# Port de `clamd` publié sur l'hôte. Format : entier 1-65535. Requise : oui en développement.
CLAMAV_PORT=3310

# =============================================================================================
# 11. Production
# =============================================================================================
# Ces variables ne servent qu'à l'overlay `docker-compose.prod.yml`.

# Domaine servi par Caddy, qui termine TLS et sert la webapp. Format : nom de domaine pleinement
# qualifié. Requise : oui en production.
APP_DOMAIN=CHANGE_ME_APP_DOMAIN

# Adresse de contact transmise à l'autorité de certification pour l'émission ACME.
# Format : adresse email. Requise : oui en production.
CADDY_ACME_EMAIL=CHANGE_ME_CADDY_ACME_EMAIL

# =============================================================================================
# 12. Messagerie
# =============================================================================================
# Depuis `CRM-050`, `CRM_INBOUND_DOMAIN` est **réellement consommée** : Stalwart lui attache la
# boîte système catch-all du développement. Depuis `CRM-051`, `MAIL_SYNC_INTERNAL_TOKEN` et
# `MAIL_SYNC_LOG_LEVEL` le sont aussi : le service `mail-sync` les lit au démarrage. Depuis
# `CRM-052`, il lit également `SERVICE_ROLE_KEY` — déjà déclarée plus haut — et
# `MAIL_SYNC_IMAP_TIMEOUT_SECONDS`. Les autres
# attendent encore leur service et n'ont aucun effet sur la pile ; elles sont documentées ici
# parce que `README.md` §9 et `docs/PROD_MIGRATIONS.md` §2.3 les annoncent comme obligatoires.

# Domaine des adresses email générées pour les cards. La valeur de développement est celle que le
# seed écrit dans `workspaces.inbound_domain` : les deux DOIVENT coïncider, faute de quoi la boîte
# système n'attraperait aucune des adresses que le produit génère (docs/JOURNAL.md décision 237).
# `scripts/verify-mail-infra.sh` compare les deux. Format : nom de domaine pleinement qualifié.
# Requise : oui en développement depuis CRM-050.
CRM_INBOUND_DOMAIN=crm.p2enjoy.test

# Domaine des boîtes personnelles de l'équipe, distinct de celui des cards. Les deux domaines
# restent séparés à dessein : `docs/SPEC-mail-subsystem.md` §1 pose que le compte entrant d'un
# utilisateur et le domaine des cards sont deux objets indépendants, et les confondre en
# développement rendrait indétectable une erreur de routage que la production exhiberait.
# Sa valeur est celle des comptes du seed socle — `admin@p2enjoy.test`, `bizdev@p2enjoy.test` —
# afin qu'un développeur n'ait pas deux identités à retenir.
# Décidée par `docs/JOURNAL.md` décision 251 ; **pas encore consommée** : le domaine est aujourd'hui
# écrit en dur dans les scripts de preuve. Format : nom de domaine pleinement qualifié.
# Requise : non pour l'instant.
MAIL_TEAM_DOMAIN=p2enjoy.test

# Jeton de l'API interne du service `mail-sync` (docs/SPEC-mail-subsystem.md §12.2). Il n'ouvre
# aucun accès à PostgreSQL : il n'autorise que `GET /internal/v1/status` et, en profil `dev`, le
# checkpoint de preuve. Le service refuse de démarrer en dessous de 32 caractères.
# **Tiré au hasard par `runDev.sh`**, y compris sur un `.env` antérieur à `CRM-051`.
# Format : chaîne d'au moins 32 caractères. Requise : oui depuis CRM-051.
MAIL_SYNC_INTERNAL_TOKEN=CHANGE_ME_MAIL_SYNC_INTERNAL_TOKEN

# Niveau de journalisation du service `mail-sync`. Le nominal ne produit aucune ligne de niveau
# `WARNING` ou supérieur (docs/SPEC-mail-subsystem.md §12.5).
# Format : DEBUG, INFO, WARNING, ERROR ou CRITICAL. Requise : oui depuis CRM-051.
MAIL_SYNC_LOG_LEVEL=INFO

# Borne d'un test de connexion IMAP, en secondes (docs/SPEC-mail-subsystem.md §13.5). Un compte
# injoignable ne doit pas retenir un appelant plus longtemps qu'il ne faut pour conclure.
# Format : nombre strictement positif, au plus 120. Requise : non — défaut 10.
MAIL_SYNC_IMAP_TIMEOUT_SECONDS=10

# Borne d'un test de connexion SMTP, en secondes (docs/SPEC-mail-subsystem.md §14.5). Elle est
# DISTINCTE de celle d'IMAP, et plus longue : un serveur applique couramment un délai de pénalité
# sur un échec d'authentification — mesuré à dix secondes sur la pile locale —, et un réglage trop
# court rapporterait un mot de passe faux comme un dépassement de délai.
# Format : nombre strictement positif, au plus 120. Requise : non — défaut 30.
MAIL_SYNC_SMTP_TIMEOUT_SECONDS=30

# Intervalle de la boucle de veille qui relève les boîtes IMAP, en secondes.
# CONSOMMÉE DEPUIS CRM-059 ; elle était déclarée et lue par rien jusque-là.
#
# 0 DÉSACTIVE la veille — ce n'est pas « aussi vite que possible ». La relève reste alors
# déclenchable par l'API interne, ce dont l'environnement de preuve a besoin pour décider
# lui-même du moment.
#
# IDLE n'est PAS employé, bien que le serveur l'annonce : une scrutation déclarée est
# observable et rejouable, là où une connexion permanente par compte est un état de plus à
# superviser (docs/SPEC-mail-subsystem.md §20.2).
#
# Format : entier, 0 ou compris entre 5 et 3600. Hors bornes, le service REFUSE de démarrer
# au lieu de corriger en silence. Requise : non — défaut 60.
MAIL_SYNC_POLL_INTERVAL=60

# Taille maximale d'une pièce jointe ingérée, en mébioctets. Format : entier.
# Requise : oui à partir de CRM-054.
MAIL_MAX_ATTACHMENT_MB=25

# --- Sauvegardes chiffrées — CRM-080 ---------------------------------------------------------
#
# `scripts/backup.sh` produit une archive chiffrée de la base, de la clé racine de Vault et du
# dépôt objet lorsqu'il est local (docs/SPEC-backups.md §3).

# Fichier des CLÉS PUBLIQUES `age` destinataires du chiffrement.
#
# Seules des clés publiques y figurent : l'hôte qui produit les sauvegardes ne peut relire aucune
# de ses propres archives, et sa compromission ne livre pas l'historique. La clé privée
# correspondante vit hors de cet hôte, et `scripts/backup.sh` ne la lit JAMAIS.
#
# Une phrase de passe serait le contraire : elle transiterait par l'environnement d'une tâche
# planifiée, donc par la table des processus (docs/SPEC-backups.md §3.4).
#
# Format : chemin absolu vers un fichier lisible portant une clé `age1…` ou `ssh-…` par ligne.
# Exemple non sensible : `/etc/p2enjoy/backup-recipients.txt`.
# Requise : oui pour `scripts/backup.sh` — sans elle le script REFUSE de s'exécuter. Elle est
# LAISSÉE VIDE ici, et c'est délibéré : la pile de développement ne sauvegarde rien, et une valeur
# d'exemple non vide ferait exiger par `env_validate` un fichier de clés que `./runDev.sh` n'a
# aucune raison de réclamer. La variable se renseigne sur l'hôte qui sauvegarde, dans `.env` ou
# dans l'environnement du shell — ce dernier prévaut.
BACKUP_AGE_RECIPIENTS_FILE=

# Répertoire de dépôt des archives. Il doit être HORS du dépôt Git : le script refuse tout chemin
# situé sous la racine du dépôt, y compris par un détour `..` (docs/SPEC-backups.md §3.7, R7).
# Format : chemin absolu. Exemple non sensible : `/var/backups/p2enjoy`, qui est aussi le défaut.
# Requise : non.
BACKUP_OUTPUT_DIR=

# Âge maximal, en jours, d'une archive conservée dans le répertoire de sortie. La rétention ne
# s'applique qu'APRÈS une écriture réussie, ne vise que le motif `p2enjoy-sauvegarde-*.tar.age`,
# et ÉNUMÈRE chaque suppression. La valeur `0` est refusée : elle effacerait l'archive qui vient
# d'être écrite. Format : entier >= 1. Exemple non sensible : `30`, qui est aussi le défaut.
# Requise : non.
BACKUP_RETENTION_DAYS=
