{
  // @spec CRM-006 (docs/BACKLOG.md) — compilation des types générés et de leurs assertions
  // @spec docs/SPEC-types.md §4 (commande `typecheck`), §9 (limite : configuration à la racine)
  //
  // Cette configuration ne couvre que ce que CRM-006 livre. `CRM-007` apportera celle de la
  // webapp ; la racine cessera alors d'être le seul point de compilation.
  //
  // Les options d'émission sont volontairement absentes : `noEmit` est vrai, ce projet ne
  // compile rien vers du JavaScript, il vérifie un contrat de types.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,

    // Aucune dépendance typée n'est installée : il n'y a aucun `.d.ts` tiers à ignorer, et
    // ignorer serait de toute façon relâcher une vérification sans motif.
    "skipLibCheck": false,
    "noEmit": true
  },
  "include": ["webapp/src/lib/**/*.ts"]
}
